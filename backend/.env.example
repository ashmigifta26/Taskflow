# Database (default: SQLite file in backend folder)
DATABASE_URL=sqlite:///./taskflow.db

# JWT — change in production
JWT_SECRET=your-secret-key-here
JWT_EXPIRE_DAYS=30

# Google Sign-In (optional; mock login works without this)
GOOGLE_CLIENT_ID=

# Firebase push (optional; simulation mode if unset)
FIREBASE_CREDENTIALS_JSON=path/to/firebase-service-account.json

# CORS — comma-separated origins, or * for development
CORS_ORIGINS=*

# How often the server checks for due tasks (seconds)
REMINDER_POLL_SECONDS=30
